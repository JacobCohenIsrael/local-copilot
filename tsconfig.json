{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "src/supervisor-cli.ts",
    "src/supervisor/**/*.ts",
    "test/supervisor.test.ts"
  ],
  "exclude": ["node_modules", "dist", ".runtime"]
}
