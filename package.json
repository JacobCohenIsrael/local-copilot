{
  "name": "local-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Simulation-only lifecycle supervisor for a Strata local coding worker",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "strata-supervisor-sim": "./dist/src/supervisor-cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prestart": "npm run build",
    "start": "node dist/src/supervisor-cli.js",
    "test": "npm run build && node --test dist/test/supervisor.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2"
  }
}
